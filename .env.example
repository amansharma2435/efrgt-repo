# Copy this file to .env and paste your own key.
# Create a key at https://aistudio.google.com/apikey
# Do not commit the real .env file. Do not put the key in source code.
GEMINI_API_KEY=

# Optional. Use a Flash model id shown in Google AI Studio.
# If Gemini replies that the model is unknown, change this value.
GEMINI_MODEL=gemini-2.5-flash
